{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/cv-tran-quang-luong.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "inline; filename=\"Tran-Quang-Luong-CV.pdf\"" }
      ]
    }
  ]
}
